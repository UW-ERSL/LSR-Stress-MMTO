  "mmto": {
    "schema_version": 1,
    "name": "Airplane bracket",
    "physics": "structural",
    "comment": "Airplane bracket (Liao 2024 geometry), z-half, 20 materials, min p-norm failure factor s.t. mass and cost",
    "mesh": {
      "n_dof": 150000,
      "single_layer": false
    },
    "selections": {
      "bores": {
        "type": "union",
        "of": [
          {
            "type": "cylinder",
            "center": [
              0.1,
